{
  "name": "trueforge-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Small game integration branch for focused Shelled fixes; benchmark history remains on main.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build:preview-engine": "node --import tsx scripts/build-preview-engine.ts",
    "check:preview-engine": "node --import tsx scripts/build-preview-engine.ts --check",
    "verify": "npm run check:preview-engine && npm run check:variants && npm test",
    "build": "npm run check:preview-engine && npm run check:variants && npm run build:web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test sokoban/*.test.ts",
    "build:web": "node --import tsx scripts/build-web.ts",
    "build:variants": "node --import tsx scripts/build-variants.ts",
    "check:variants": "node --import tsx scripts/build-variants.ts --check"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "^0.180.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
